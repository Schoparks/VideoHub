{
  "name": "yingji-video-hub",
  "version": "0.1.0",
  "private": true,
  "description": "映集 — 手柄优先的跨平台聚合播放器",
  "author": "VideoHub contributors",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:android": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc --noEmit -p tsconfig.android.json && node scripts/package-android.mjs",
    "dist": "pnpm build && electron-builder",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "core-js": "^3.50.0",
    "dashjs": "^5.0.3",
    "graphemer": "^1.4.0",
    "hls.js": "^1.6.13",
    "jsbi": "^4.3.2",
    "lucide-react": "^0.468.0",
    "mpegts.js": "^1.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resize-observer-polyfill": "^1.5.1",
    "wicg-inert": "^3.1.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "app.yingji.player",
    "productName": "Yingji",
    "icon": "public/app-icon-512.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
